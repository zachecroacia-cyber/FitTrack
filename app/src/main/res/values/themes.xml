<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.FitTrack"
        parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Colores principales FitTrack -->
        <item name="colorPrimary">@color/fittrack_green</item>
        <item name="colorOnPrimary">@color/black</item>

        <item name="colorSecondary">@color/fittrack_green</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Fondo -->
        <item name="android:colorBackground">@color/fittrack_background</item>
        <item name="colorSurface">@color/fittrack_background</item>

        <!-- TODO el texto en blanco -->
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnBackground">@color/white</item>

        <item name="android:textColor">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/white</item>
        <item name="android:textColorHint">@color/white</item>

        <!-- Campos de texto -->
        <item name="colorOnSurfaceVariant">@color/white</item>

        <!-- Barras del sistema -->
        <item name="android:statusBarColor">@color/fittrack_background</item>
        <item name="android:navigationBarColor">@color/fittrack_background</item>

        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

    </style>

    <style name="Theme.FitTrack"
        parent="Base.Theme.FitTrack" />

</resources>